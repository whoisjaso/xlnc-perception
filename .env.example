# Nova Wheels
# Leave these blank to run fully local (data persists in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Google Places key for address autocomplete. Falls back to Photon (OpenStreetMap) when blank.
VITE_GOOGLE_PLACES_KEY=

# Optional: Stripe publishable key for card-on-file (UI only; server-side capture is out of scope).
VITE_STRIPE_PUBLISHABLE_KEY=
